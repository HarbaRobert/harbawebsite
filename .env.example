# Copy this file to .env and fill in real values. Never commit .env.
#
# See SEO_SETUP.md for what each of these does and how to obtain the values.

# --- Site identity -----------------------------------------------------
# The production hostname, no trailing slash. Used to build every canonical
# URL, the sitemap, robots.txt, and Open Graph URLs. Read at build time by
# the client bundle and prerendered pages (requires a rebuild to change),
# and at request time by the Express server for /robots.txt and
# /sitemap.xml (no rebuild needed to change those two).
PUBLIC_SITE_URL=https://harba.fly.dev

# Only needed once the signed-in application is deployed on a different host
# from this marketing site. Leave blank while they are the same site (the
# current setup): /login's "back to Harba" link then safely falls back to a
# relative path instead of a hardcoded domain.
MARKETING_SITE_URL=

# --- Search engine verification (optional) ------------------------------
# Leave blank to omit the verification meta tag entirely. Never commit a
# real value to a public file; set it as a deploy secret instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Analytics (optional) ------------------------------------------------
# Leave blank to disable GA4 entirely. Even when set, GA4 will not load
# until a visitor accepts analytics cookies via the on-site banner.
GA_MEASUREMENT_ID=

# --- Working-session email (existing, unrelated to this SEO work) -------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
WORKING_SESSION_TO=rob@harba.ai
MAIL_FROM=

# --- Technical Review workspace (/technical-review) ----------------------
# A shared access code required to read or write review answers. Generate
# any long random string; give it to Rob and Harry, not published anywhere.
# Without it, /api/review/* returns 503 and the workspace shows an access
# gate that can never succeed.
REVIEW_ACCESS_TOKEN=

# Used by server/reviewTranscript.js to draft answers from an uploaded call
# transcript. Without it, "Populate answers from a call transcript" returns
# a clear "not configured" error; everything else in the workspace still
# works. Get a key from platform.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Where server/db.js's SQLite file is written. Defaults to ./.data locally.
# In production this is set in fly.toml to the mounted volume's path
# (/data) and does not need to be set here.
DATA_DIR=
